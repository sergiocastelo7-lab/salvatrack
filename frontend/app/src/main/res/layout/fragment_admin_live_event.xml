<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF2F7">

    <!-- Cabecera -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnVolverAdmin"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="#1A1A2E"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Panel Admin — Evento en Directo"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_lap_number"
                android:backgroundTint="#FEF3C7"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚡"
                    android:textSize="16sp"
                    android:layout_marginEnd="10dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Los cambios se aplican en tiempo real para todos los usuarios. Deja un campo vacío para usar el enlace por defecto."
                    android:textSize="12sp"
                    android:textColor="#92400E"
                    android:lineSpacingExtra="2dp"/>
            </LinearLayout>

            <!-- ProgressBar -->
            <ProgressBar
                android:id="@+id/pbAdmin"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                android:indeterminate="true"
                android:indeterminateTint="#1976D2"
                android:visibility="visible"/>

            <LinearLayout
                android:id="@+id/llAdminForm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Resultados -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="🌐"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:background="@drawable/bg_lap_number"
                                android:backgroundTint="#DBEAFE"
                                android:layout_marginEnd="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resultados"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E"/>
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etCurrentResultados"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="https://... (vacío = enlace por defecto)"
                            android:textSize="13sp"
                            android:textColor="#1A1A2E"
                            android:textColorHint="#A0AEC0"
                            android:background="@drawable/bg_lap_number"
                            android:backgroundTint="#F1F5F9"
                            android:padding="10dp"
                            android:inputType="textUri"
                            android:maxLines="2"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Salidas -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="📋"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:background="@drawable/bg_lap_number"
                                android:backgroundTint="#F1F5F9"
                                android:layout_marginEnd="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lista de Salida"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E"/>
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etCurrentSalidas"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="https://... (vacío = no disponible)"
                            android:textSize="13sp"
                            android:textColor="#1A1A2E"
                            android:textColorHint="#A0AEC0"
                            android:background="@drawable/bg_lap_number"
                            android:backgroundTint="#F1F5F9"
                            android:padding="10dp"
                            android:inputType="textUri"
                            android:maxLines="2"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Streaming -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="8dp">

                            <TextView
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:text="▶"
                                android:textSize="16sp"
                                android:textColor="#E53935"
                                android:gravity="center"
                                android:background="@drawable/bg_lap_number"
                                android:backgroundTint="#FFEBEE"
                                android:layout_marginEnd="10dp"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Streaming"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E"/>
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etCurrentStreaming"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="https://... (vacío = enlace por defecto)"
                            android:textSize="13sp"
                            android:textColor="#1A1A2E"
                            android:textColorHint="#A0AEC0"
                            android:background="@drawable/bg_lap_number"
                            android:backgroundTint="#F1F5F9"
                            android:padding="10dp"
                            android:inputType="textUri"
                            android:maxLines="2"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Botón Guardar -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGuardarAdmin"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="Guardar cambios"
                    android:textColor="#FFFFFF"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="#1976D2"
                    app:cornerRadius="16dp"/>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>