<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#EEF2F7">

    <!-- Cabecera con botón atrás -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:text="‹"
            android:textSize="28sp"
            android:textColor="#1A1A2E"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Evento en Directo"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1A1A2E"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="32dp">

            <!-- Banner rojo del evento -->
            <LinearLayout
                android:id="@+id/llBannerEvento"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_evento_rojo"
                android:padding="20dp"
                android:layout_marginBottom="28dp">

                <!-- Federación con punto -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_lap_number"
                        android:backgroundTint="#FFFFFF"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tvDirectoFederacion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FESSGA"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        android:letterSpacing="0.08"/>
                </LinearLayout>

                <!-- Nombre del evento -->
                <TextView
                    android:id="@+id/tvDirectoNombre"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="—"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp"/>

                <!-- Sede -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📍"
                        android:textSize="13sp"
                        android:layout_marginEnd="4dp"/>

                    <TextView
                        android:id="@+id/tvDirectoSede"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textSize="14sp"
                        android:textColor="#FFCDD2"/>
                </LinearLayout>
            </LinearLayout>

            <!-- Sección ACCESOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ACCESOS"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#A0AEC0"
                android:letterSpacing="0.1"
                android:layout_marginBottom="10dp"/>

            <!-- ProgressBar cargando -->
            <ProgressBar
                android:id="@+id/pbDirecto"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:indeterminateTint="#1976D2"
                android:visibility="visible"/>

            <!-- Accesos (se muestran cuando carga Firebase) -->
            <LinearLayout
                android:id="@+id/llAccesos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Resultados -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardResultadosDirecto"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="12dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="🌐"
                            android:textSize="20sp"
                            android:gravity="center"
                            android:background="@drawable/bg_lap_number"
                            android:backgroundTint="#DBEAFE"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resultados"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ver clasificaciones en tiempo real"
                                android:textSize="12sp"
                                android:textColor="#A0AEC0"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#A0AEC0"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Lista de Salida -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardSalidas"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#F8FAFC"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="📋"
                            android:textSize="20sp"
                            android:gravity="center"
                            android:background="@drawable/bg_lap_number"
                            android:backgroundTint="#F1F5F9"
                            android:alpha="0.5"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lista de Salida"
                                android:textSize="15sp"
                                android:textColor="#A0AEC0"/>

                            <TextView
                                android:id="@+id/tvSalidasSubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No disponible para este evento"
                                android:textSize="12sp"
                                android:textColor="#CBD5E0"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⊘"
                            android:textSize="18sp"
                            android:textColor="#CBD5E0"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Streaming -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardStreaming"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="20dp"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp">

                        <TextView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:text="▶"
                            android:textSize="18sp"
                            android:gravity="center"
                            android:textColor="#E53935"
                            android:background="@drawable/bg_lap_number"
                            android:backgroundTint="#FFEBEE"
                            android:layout_marginEnd="16dp"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Streaming"
                                android:textSize="15sp"
                                android:textStyle="bold"
                                android:textColor="#1A1A2E"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Ver la retransmisión en directo"
                                android:textSize="12sp"
                                android:textColor="#A0AEC0"/>
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="›"
                            android:textSize="22sp"
                            android:textColor="#A0AEC0"/>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>