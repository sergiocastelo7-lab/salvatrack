<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="32dp"
    android:background="@color/card">

    <!-- Pastilla decorativa -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@drawable/bg_lap_number"
        android:backgroundTint="#E2E8F0"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="20dp"/>

    <!-- Título de la sección -->
    <TextView
        android:id="@+id/tvBottomSheetTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mínimas"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="6dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Selecciona la federación"
        android:textSize="13sp"
        android:textColor="#A0AEC0"
        android:layout_marginBottom="20dp"/>

    <!-- Opción FESSGA -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardFessga"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/logo_fessga"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_lap_number"
                android:backgroundTint="#DBEAFE"
                android:padding="4dp"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FESSGA"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Federación Gallega"
                    android:textSize="12sp"
                    android:textColor="#A0AEC0"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="#A0AEC0"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Opción RFESS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardRfess"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="#FFFFFF"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/logo_rfess"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_lap_number"
                android:backgroundTint="#FFFFFF"
                android:padding="4dp"
                android:layout_marginEnd="16dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RFESS"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Federación Española"
                    android:textSize="12sp"
                    android:textColor="#A0AEC0"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="22sp"
                android:textColor="#A0AEC0"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>