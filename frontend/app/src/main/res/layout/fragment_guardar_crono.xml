<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="24dp"
    android:paddingBottom="24dp">

    <!-- Título -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Guardar tiempo"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#1A1A2E"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvTiempoAGuardar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00.00"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1976D2"
        android:fontFamily="monospace"
        android:layout_marginBottom="20dp"/>

    <!-- Nombre (opcional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre (opcional)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:layout_marginBottom="4dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1F5F9">
        <EditText
            android:id="@+id/etNombreTiempo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Ej: Entrenamiento martes"
            android:textSize="14sp"
            android:textColor="#1A1A2E"
            android:textColorHint="#A0AEC0"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:maxLines="1"/>
    </androidx.cardview.widget.CardView>

    <!-- Prueba (opcional) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Prueba (opcional)"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:layout_marginBottom="4dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="#F1F5F9">
        <EditText
            android:id="@+id/etPrueba"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:hint="Ej: 100m Remolque Maniquí"
            android:textSize="14sp"
            android:textColor="#1A1A2E"
            android:textColorHint="#A0AEC0"
            android:background="@android:color/transparent"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:inputType="text"
            android:maxLines="1"/>
    </androidx.cardview.widget.CardView>

    <!-- Piscina -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Piscina / Entorno"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="#64748B"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

        <TextView android:id="@+id/chip25m"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:text="25m"
            android:gravity="center" android:textSize="13sp"
            android:textStyle="bold" android:textColor="#1976D2"
            android:background="@drawable/bg_lap_number"
            android:backgroundTint="#DBEAFE"
            android:layout_marginEnd="8dp"
            android:clickable="true" android:focusable="true"/>

        <TextView android:id="@+id/chip50m"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="1" android:text="50m"
            android:gravity="center" android:textSize="13sp"
            android:textColor="#64748B"
            android:background="@drawable/bg_lap_number"
            android:backgroundTint="#F1F5F9"
            android:clickable="true" android:focusable="true"/>

        <!-- chipPlaya oculto para compatibilidad con GuardarCronoMultiDialog -->
        <TextView android:id="@+id/chipPlaya"
            android:layout_width="0dp" android:layout_height="36dp"
            android:layout_weight="0"
            android:visibility="gone"/>

    </LinearLayout>

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelarGuardar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Cancelar"
            android:textColor="#64748B"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:layout_marginEnd="8dp"
            app:backgroundTint="#F1F5F9"
            app:cornerRadius="12dp"
            style="@style/Widget.MaterialComponents.Button.UnelevatedButton"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmarGuardar"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Guardar"
            android:textColor="#FFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="#1976D2"
            app:cornerRadius="12dp"/>
    </LinearLayout>

</LinearLayout>