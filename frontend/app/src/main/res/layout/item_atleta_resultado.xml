<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Fila principal -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="?attr/selectableItemBackground">

        <!-- Avatar con iniciales -->
        <TextView
            android:id="@+id/tvIniciales"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:text="AB"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:gravity="center"
            android:background="@drawable/bg_avatar_circulo"
            android:layout_marginEnd="14dp"/>

        <!-- Nombre + club/categoría -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvNombreAtleta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NOMBRE APELLIDO"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A2E"/>

            <TextView
                android:id="@+id/tvClubCategoria"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Club · Categoría"
                android:textSize="12sp"
                android:textColor="#A0AEC0"/>
        </LinearLayout>

        <!-- Flecha -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="›"
            android:textSize="22sp"
            android:textColor="#CBD5E0"/>
    </LinearLayout>

    <!-- Divisor entre items -->
    <View
        android:id="@+id/viewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        android:layout_marginStart="74dp"/>

</LinearLayout>